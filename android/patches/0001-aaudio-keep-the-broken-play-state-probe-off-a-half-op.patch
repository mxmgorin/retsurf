aaudio: keep the broken-play-state probe off a half-open device

SDL 2.26.4 calls aaudio_DetectBrokenPlayState() from Android_PumpEvents on the
main thread, while SDL_OpenAudioDevice() may run on any other. aaudio_OpenDevice
publishes the device into the `audioDevice` global before the stream builder has
returned a stream, so the probe reaches AAudioStream_getTimestamp(NULL) and the
process takes SIGSEGV inside libaaudio. aaudio_CloseDevice leaves the same window
open from the other end: it stops and closes the stream before unpublishing.

retsurf opens a playback device per AudioContext from Servo media threads, so a
page with sound hits this within a frame or two of starting audio.

--- a/src/audio/aaudio/SDL_aaudio.c
+++ b/src/audio/aaudio/SDL_aaudio.c
@@ -174,6 +174,14 @@
     aaudio_result_t res;
     LOGI(__func__);
 
+    /* Unpublish before the stream goes away: aaudio_DetectBrokenPlayState() reads
+       the device off the event pump, on another thread than this. */
+    if (this->iscapture) {
+        captureDevice = NULL;
+    } else {
+        audioDevice = NULL;
+    }
+
     if (private->stream) {
         res = ctx.AAudioStream_requestStop(private->stream);
         if (res != AAUDIO_OK) {
@@ -190,14 +198,6 @@
         }
     }
 
-    if (this->iscapture) {
-        SDL_assert(captureDevice == this);
-        captureDevice = NULL;
-    } else {
-        SDL_assert(audioDevice == this);
-        audioDevice = NULL;
-    }
-
     SDL_free(this->hidden->mixbuf);
     SDL_free(this->hidden);
 }
@@ -447,6 +447,12 @@
 
     private = audioDevice->hidden;
 
+    /* aaudio_OpenDevice() publishes the device before the builder hands back a
+       stream, so this can run while there is none. */
+    if ( !private->stream ) {
+        return SDL_FALSE;
+    }
+
     res = ctx.AAudioStream_getTimestamp( private->stream, CLOCK_MONOTONIC, &framePosition, &timeNanoseconds );
     if ( res == AAUDIO_ERROR_INVALID_STATE ) {
         aaudio_stream_state_t currentState = ctx.AAudioStream_getState( private->stream );
