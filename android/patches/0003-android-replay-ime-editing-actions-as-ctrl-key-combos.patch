android: replay IME editing actions as Ctrl key combos

Hardware-keyboard IMEs (Pastiera on the Titan 2) deliver Ctrl+C/V/X/A/Z as
InputConnection.performContextMenuAction, which BaseInputConnection ignores, so
the app never saw copy, paste, cut, select all or undo.

--- a/android-project/app/src/main/java/org/libsdl/app/SDLActivity.java
+++ b/android-project/app/src/main/java/org/libsdl/app/SDLActivity.java
@@ -1985,6 +1985,25 @@
     }
 
     @Override
+    public boolean performContextMenuAction(int id) {
+        // Hardware-keyboard IMEs send their editing shortcuts here; replay them as Ctrl combos.
+        int key;
+        switch (id) {
+            case android.R.id.copy: key = KeyEvent.KEYCODE_C; break;
+            case android.R.id.paste: key = KeyEvent.KEYCODE_V; break;
+            case android.R.id.cut: key = KeyEvent.KEYCODE_X; break;
+            case android.R.id.selectAll: key = KeyEvent.KEYCODE_A; break;
+            case android.R.id.undo: key = KeyEvent.KEYCODE_Z; break;
+            default: return super.performContextMenuAction(id);
+        }
+        SDLActivity.onNativeKeyDown(KeyEvent.KEYCODE_CTRL_LEFT);
+        SDLActivity.onNativeKeyDown(key);
+        SDLActivity.onNativeKeyUp(key);
+        SDLActivity.onNativeKeyUp(KeyEvent.KEYCODE_CTRL_LEFT);
+        return true;
+    }
+
+    @Override
     public boolean commitText(CharSequence text, int newCursorPosition) {
         if (!super.commitText(text, newCursorPosition)) {
             return false;
