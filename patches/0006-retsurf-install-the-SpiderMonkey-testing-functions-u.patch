From f72068524c776ac06438d3b85a3c4ddbd1d4d708 Mon Sep 17 00:00:00 2001
From: mxmgorin <102797145+mxmgorin@users.noreply.github.com>
Date: Fri, 28 Aug 2026 10:53:40 +0300
Subject: [PATCH 6/7] retsurf: install the SpiderMonkey testing functions under
 the internals pref
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

dumpHeap, findPath and shortestPaths are compiled into a release
SpiderMonkey — the declarations sit outside every DEBUG guard and nm shows
them as global text in libjs_static.a. Only the JS shell ever calls
DefineTestingFunctions, so nothing put them on a page's global. The symbol
is taken by mangled name because the header is private, and fuzzingSafe is
false so shortestPaths comes with it.
---
 components/script/dom/window/window.rs | 31 +++++++++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

diff --git a/components/script/dom/window/window.rs b/components/script/dom/window/window.rs
index 22cd1fb4cb8..7c20da06534 100644
--- a/components/script/dom/window/window.rs
+++ b/components/script/dom/window/window.rs
@@ -4015,7 +4015,11 @@ impl Window {
             has_dispatched_input_event: Cell::new(false),
         });
 
-        WindowBinding::Wrap::<crate::DomTypeHolder>(cx, &origin, win)
+        let window = WindowBinding::Wrap::<crate::DomTypeHolder>(cx, &origin, win);
+        if pref!(expose_servointernals_globally) {
+            define_js_testing_functions(cx, &window);
+        }
+        window
     }
 
     pub(crate) fn task_manager(&self) -> Rc<TaskManager> {
@@ -4239,3 +4243,28 @@ impl HasOrigin for Window {
         Window::origin(self)
     }
 }
+
+/// SpiderMonkey compiles `dumpHeap`, `findPath` and `shortestPaths` into every build;
+/// only the JS shell ever installs them on a global.
+#[expect(unsafe_code)]
+fn define_js_testing_functions(cx: &mut JSContext, window: &Window) {
+    let global = window.reflector().rootable().get_unsafe();
+    let mut realm = AutoRealm::new(cx, NonNull::new(unsafe { *global }).unwrap());
+    let cx = &mut *realm;
+    // fuzzing_safe = false is what keeps shortestPaths, which walks back to the GC roots.
+    if !unsafe { js_DefineTestingFunctions(cx.raw_cx(), global, false, true) } {
+        warn!("could not define the SpiderMonkey testing functions");
+    }
+}
+
+#[expect(unsafe_code)]
+unsafe extern "C" {
+    /// `js::DefineTestingFunctions` lives in a private header, so it is taken by symbol.
+    #[link_name = "_ZN2js22DefineTestingFunctionsEP9JSContextN2JS6HandleIP8JSObjectEEbb"]
+    fn js_DefineTestingFunctions(
+        cx: *mut RawJSContext,
+        obj: *mut *mut JSObject,
+        fuzzing_safe: bool,
+        disable_oom_functions: bool,
+    ) -> bool;
+}
