From f0a66c04f56517844bf7c75409896870c74e08a5 Mon Sep 17 00:00:00 2001
From: mxmgorin <102797145+mxmgorin@users.noreply.github.com>
Date: Thu, 27 Aug 2026 16:16:39 +0300
Subject: [PATCH 3/7] retsurf: drop a script message whose event loop is gone

---
 components/script/messaging.rs | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/components/script/messaging.rs b/components/script/messaging.rs
index e6fd889e789..ad9e5017f85 100644
--- a/components/script/messaging.rs
+++ b/components/script/messaging.rs
@@ -370,7 +370,11 @@ impl QueuedTaskConversion for MainThreadScriptMsg {
 
 impl OpaqueSender<CommonScriptMsg> for ScriptEventLoopSender {
     fn send(&self, message: CommonScriptMsg) {
-        self.send(message).unwrap()
+        // A script event loop that is already gone cannot be told anything, and
+        // an embedder built with `panic = "abort"` dies of the unwrap.
+        if self.send(message).is_err() {
+            log::warn!("dropping a script message: its event loop is gone");
+        }
     }
 }
 
