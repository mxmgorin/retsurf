From f2cf0416836c5fe38d8dd3cf0ee1c7dcb977402c Mon Sep 17 00:00:00 2001
From: mxmgorin <102797145+mxmgorin@users.noreply.github.com>
Date: Tue, 28 Jul 2026 15:55:19 +0300
Subject: [PATCH 2/7] retsurf: advance the containing-block walk past boxless
 ancestors (integration only, do not send upstream)

---
 components/layout/query.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/components/layout/query.rs b/components/layout/query.rs
index db730595c5d..f57d565b442 100644
--- a/components/layout/query.rs
+++ b/components/layout/query.rs
@@ -793,6 +793,13 @@ fn containing_block_for_node<'a>(node: ServoLayoutNode<'a>) -> Option<ServoLayou
 
     #[expect(unsafe_code)]
     while let Some(ancestor) = unsafe { current_ancestor.dangerous_flat_tree_parent() } {
+        // retsurf patch: advance before the boxless-ancestor skip below. A
+        // `display: contents` ancestor has no layout box, and the original
+        // `continue` left `current_ancestor` in place, so the walk re-read the
+        // same parent forever and hung the script thread. The same walk in
+        // `process_scroll_container_query` advances here too. docs/SERVO_PATCH.md.
+        current_ancestor = ancestor;
+
         let Some((ancestor_style, ancestor_flags)) = style_and_flags_for_node(&ancestor) else {
             continue;
         };
@@ -803,7 +810,6 @@ fn containing_block_for_node<'a>(node: ServoLayoutNode<'a>) -> Option<ServoLayou
         }
 
         current_position_value = ancestor_style.clone_position();
-        current_ancestor = ancestor;
     }
     None
 }
